# NetAtlas – kopiera till .env och fyll i.  cp .env.example .env
# Slumpa fram APP_SECRET och POSTGRES_PASSWORD med:  openssl rand -hex 32
# (hex behöver inte URL-kodas i DATABASE_URL). Värden som innehåller $ skrivs inom enkla citattecken: '...'

# ---- inloggning på servern ----
APP_USER=admin
# lösenordet du loggar in med, minst 8 tecken
APP_PASSWORD=
# minst 32 tecken; signerar inloggningar och krypterar tvåstegsnycklar. Byt inte i onödan.
APP_SECRET=
# tvåstegsinloggning (kod från autentiseringsapp):
#   optional = erbjuds vid första inloggningen (rekommenderas), kan hoppas över och slås på/av under Inställningar
#   required = måste aktiveras vid första inloggningen
#   off      = används inte
LOGIN_2FA=optional
# hur länge en inloggning gäller (timmar)
SESSION_HOURS=12

# ---- webbserver ----
PORT=8770
# on = HTTPS med självsignerat certifikat som skapas automatiskt; off = bakom en reverse proxy som sköter HTTPS
TLS=on
# extra namn/IP-adresser i certifikatet, t.ex. din Unraid-servers IP och namn
TLS_HOSTS=192.168.1.10,tower,tower.local
# tomt = alla värdnamn tillåts (inloggning krävs ändå); annars t.ex. 192.168.1.10,tower.local
ALLOWED_HOSTS=

# ---- nätverksskanning ----
# nät som föreslås i Skanna nätverket (containern ser annars bara sitt eget Docker-nät)
SCAN_CIDRS=192.168.1.0/24
# port på värden för databasen, används bara i host-läget (docker-compose.host.yml)
DB_HOST_PORT=5433

# ---- Unraid / filer ----
# här hamnar databasen och appens filer (certifikat, säkerhetskopior, SSH-nyckel).
# Använd samma appdata-plats som dina andra containrar, t.ex. /mnt/user/docker/appdata/netatlas
APPDATA=/mnt/user/appdata/netatlas
# användare och grupp för filerna: 99:100 = nobody:users på Unraid
PUID=99
PGID=100
TZ=Europe/Stockholm

# ---- PostgreSQL ----
POSTGRES_DB=netatlas
POSTGRES_USER=netatlas
POSTGRES_PASSWORD=
